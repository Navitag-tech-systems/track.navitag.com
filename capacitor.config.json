{
  "appId": "com.navitag.track",
  "appName": "Navitag Track",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "api.navitag.net",
      "*.navitag.com",
      "*.xendit.co"
    ]
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "auto",
    "includePlugins": [
      "@capacitor-firebase/analytics",
      "@capacitor-firebase/authentication",
      "@capacitor-firebase/messaging",
      "@capacitor/app",
      "@capacitor/app-launcher",
      "@capacitor/barcode-scanner",
      "@capacitor/browser",
      "@capacitor/network",
      "@capacitor/preferences",
      "@capacitor/share"
    ]
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": [
        "google.com",
        "apple.com"
      ]
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    }
  }
}