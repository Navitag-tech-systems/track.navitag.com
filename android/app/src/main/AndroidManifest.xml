<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Location permissions removed: the app tracks external GPS devices via the
        backend, not the phone's own location. The only consumer was an orphaned
        LocationPicker component that is never mounted/imported anywhere. Re-add
        ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION (+ the gps uses-feature) here
        if phone GPS is ever actually wired up.
    -->

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!--
        No photo/video media permissions are declared: nothing in the app reads the
        gallery (QR scanning is camera-only, sharing is text+URL only). The Facebook
        Login SDK used to inject READ_MEDIA_IMAGES/VIDEO, but it has been removed
        (rgcfaIncludeFacebook=false in variables.gradle), so there is nothing to strip.
    -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Firebase Analytics (play-services-measurement) auto-merges the
        advertising-ID permissions. We don't use the advertising ID, so strip
        them here — this lets us answer "No" to the Play Console advertising-ID
        declaration (no Data Safety advertising-ID disclosure required).
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!--
            Notification small icon + tint. Android renders the small icon from
            its alpha channel only, so this must be a white silhouette on
            transparent (ic_stat_navitag). Without it, FCM falls back to
            ic_launcher and the opaque square renders as a solid white blob.
        -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_navitag" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_color" />

        <!-- Facebook login scaffolding removed (provider unused; SDK not bundled — rgcfaIncludeFacebook=false). -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
