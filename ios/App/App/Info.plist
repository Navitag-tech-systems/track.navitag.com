<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Navitag Track</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.729666105352-6mnkdf9otlh0p2fkkrb6khjv95qjh15a</string>
			</array>
		</dict>
	</array>

	<key>NSCameraUsageDescription</key>
	<string>We need camera access to scan QR codes for linking devices to your account</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location is used only to show where you are on the map alongside your trackers. It stays on this device and is never sent to Navitag.</string>
	<!--
		LOCATION IS BACK, DELIBERATELY, AND BOTH HALVES ARE PRESENT.

		History: the strings and @capacitor/geolocation were both stripped after
		Apple returned ITMS-90683 on upload — the plugin had stayed in
		package.json, so the binary linked CoreLocation while no usage string
		declared a purpose, and the plugin's only importer (an orphaned
		LocationPicker) had been tree-shaken out anyway. The rule that came out of
		that: the plugin and the usage string ship together or neither ships.

		The "show me on the map" toggle (map search bar, left of the input) is the
		real consumer. So: @capacitor/geolocation is a dependency again, it is
		listed in android.includePlugins in capacitor.config.json (enforced by
		check-android-plugins.mjs), and the usage string above is set.

		When-in-use ONLY. There is no Always string and no location background
		mode: the watch runs while the toggle is on and the app is in the
		foreground, and nothing reads position in the background. Do not add
		NSLocationAlwaysAndWhenInUseUsageDescription without a feature that needs
		it — it is a much harder review conversation.

		The position is used on-device to draw one marker and is never transmitted,
		so it is not "collected" for the App Privacy questionnaire. That answer
		stops being true the moment anything POSTs it.
	-->


	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
